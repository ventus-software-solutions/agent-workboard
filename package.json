{
  "name": "agent-workboard",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first workboard for assigning projects and tasks to AI agents.",
  "license": "MIT",
  "author": "Ventus Software Solutions",
  "type": "module",
  "keywords": [
    "ai-agents",
    "coding-agents",
    "kanban",
    "task-board",
    "mcp",
    "model-context-protocol",
    "developer-tools",
    "self-hosted",
    "local-first",
    "react",
    "express"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ventus-software-solutions/agent-workboard.git"
  },
  "homepage": "https://ventus-software-solutions.github.io/agent-workboard/",
  "bugs": {
    "url": "https://github.com/ventus-software-solutions/agent-workboard/issues"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server/index.js",
    "dev:web": "vite --host 127.0.0.1 --port 5174",
    "build": "vite build",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "start": "node server/index.js",
    "mcp": "node server/mcp.js",
    "tasksdir:doctor": "node server/tasksdirDoctor.js",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "express": "^5.2.1",
    "lucide-react": "^1.18.0",
    "multer": "^2.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^9.2.1",
    "supertest": "^7.2.2",
    "vite": "^8.2.1",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "ip-address": "^10.3.1",
    "nanoid": "^3.3.17",
    "vitepress": {
      "vite": "^6.4.3"
    }
  }
}
